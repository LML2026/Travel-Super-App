PORT=5000
NODE_ENV=development

# Required for flight search provider integration.
DUFFEL_API_KEY=

# Optional; if omitted the AI endpoint returns fallback local plans.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Production CORS allowlist (comma-separated origins). Required when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Auth policy: defaults to true in production, false in development.
AUTH_REQUIRED=false

# Route prefixes that require Firebase ID token when auth is enabled.
AUTH_PROTECTED_PATHS=/api/flights,/api/hotels,/api/ai

# Firebase project context for token verification.
FIREBASE_PROJECT_ID=

# API rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120PORT=5000
DUFFEL_API_KEY=your_duffel_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
APP_CHECK_ENFORCED=false
